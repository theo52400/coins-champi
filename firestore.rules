rules_version = '2';
// Règles de sécurité de Coins à champi (à coller dans Firebase > Firestore Database > Règles).
// - Chaque joueur (compte anonyme) est le seul à lire et écrire son profil, ses coins secrets et ses sorties.
// - Un groupe se rejoint avec son code ; seuls ses membres voient positions, trouvailles partagées, photos et alertes.
// - Personne ne peut lister les groupes, ni modifier ou effacer ce qu'un autre a publié.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    function groupPath(gid) { return /databases/$(database)/documents/groups/$(gid); }
    function isMember(gid) { return signedIn() && exists(/databases/$(database)/documents/groups/$(gid)/members/$(request.auth.uid)); }
    function shortText(v, max) { return v is string && v.size() <= max; }
    function changes() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // ---------- espace privé de chaque joueur ----------
    match /users/{uid} {
      allow read, write: if isMe(uid);
      match /{sub}/{id} {
        allow read, write: if isMe(uid) && sub in ['finds', 'photos', 'sorties'];
      }
    }

    // ---------- groupes ----------
    match /groups/{gid} {
      // « get » permet de vérifier un code d'invitation ; « list » reste interdit
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.owner == request.auth.uid && shortText(request.resource.data.name, 40) && gid.size() >= 6 && gid.size() <= 12;
      allow update: if signedIn() && resource.data.owner == request.auth.uid && request.resource.data.owner == resource.data.owner;
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;

      match /members/{uid} {
        allow read: if isMember(gid);
        allow create, update: if isMe(uid) && exists(groupPath(gid)) && shortText(request.resource.data.name, 40);
        allow delete: if isMe(uid) || get(groupPath(gid)).data.owner == request.auth.uid;
      }

      match /presence/{uid} {
        allow read: if isMember(gid);
        allow create, update: if isMe(uid) && isMember(gid);
        allow delete: if isMe(uid);
      }

      match /finds/{fid} {
        allow read: if isMember(gid);
        allow create: if isMember(gid) && request.resource.data.uid == request.auth.uid && shortText(request.resource.data.species, 30);
        // L'auteur modifie sa trouvaille ; les autres membres ne peuvent qu'ajouter leur « bravo »
        allow update: if isMember(gid) && (
          (resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid) ||
          (changes().hasOnly(['likedBy']) && request.resource.data.likedBy.toSet() == resource.data.get('likedBy', []).toSet().union([request.auth.uid].toSet()))
        );
        allow delete: if signedIn() && (resource == null || resource.data.uid == request.auth.uid);
      }

      match /photos/{fid} {
        allow read: if isMember(gid);
        allow create: if isMember(gid) && request.resource.data.uid == request.auth.uid && shortText(request.resource.data.data, 900000);
        allow delete: if signedIn() && (resource == null || resource.data.uid == request.auth.uid);
      }

      match /events/{eid} {
        allow read: if isMember(gid);
        allow create: if isMember(gid) && request.resource.data.uid == request.auth.uid && request.resource.data.type in ['look', 'rally', 'sos', 'find', 'treasure', 'hidden'];
        allow delete: if signedIn() && (resource == null || resource.data.uid == request.auth.uid);
      }

      // Cèpes d'or : le premier membre (autre que celui qui l'a caché) qui le trouve l'inscrit à son nom
      match /challenges/{cid} {
        allow read: if isMember(gid);
        allow create: if isMember(gid) && request.resource.data.createdBy == request.auth.uid;
        allow update: if isMember(gid) && resource.data.createdBy != request.auth.uid
          && resource.data.get('foundBy', null) == null
          && changes().hasOnly(['foundBy', 'foundByName', 'foundAt'])
          && request.resource.data.foundBy == request.auth.uid;
        allow delete: if signedIn() && (resource == null || resource.data.createdBy == request.auth.uid);
      }

      match /carnets/{sid} {
        allow read: if isMember(gid);
        allow create, update: if isMember(gid) && request.resource.data.uid == request.auth.uid;
        allow delete: if signedIn() && (resource == null || resource.data.uid == request.auth.uid);
      }
    }
  }
}
